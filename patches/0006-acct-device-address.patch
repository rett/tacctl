+// acctRecord is a logged accounting record (tacctl patch 0006): the request's
+// fields, in the order and under the names upstream writes them, and after
+// them the device that sent the request. A reader that does not know "Device"
+// ignores it.
+type acctRecord struct {
+	tq.AcctRequest
+	// Device is the address of the TACACS+ client (the network device) as the
+	// server saw the connection: the value tacquito stores in the request
+	// context under tq.ContextConnRemoteAddr for every packet of a connection.
+	// "RemAddr" is the end user's address, as the device reports it. "unknown"
+	// when the context carries none.
+	Device string
+}
+
+// deviceAddr is the address of the connection the request arrived on.
+func deviceAddr(ctx context.Context) string {
+	if ctx != nil {
+		if a, _ := ctx.Value(tq.ContextConnRemoteAddr).(string); a != "" {
+			return a
+		}
+	}
+	return "unknown"
+}
+
+// marshalRecord is the record as one line of JSON, without a trailing newline.
+// "<", ">" and "&" are written as they are, not as the \u003c, \u003e and
+// \u0026 that json.Marshal escapes them to for HTML (tacctl patch 0006): a
+// command a device sends ("<cr>", "<unconfigured> -> ...") stays readable in
+// the log. The line is valid JSON either way.
+func marshalRecord(r acctRecord) ([]byte, error) {
+	var buf bytes.Buffer
+	enc := json.NewEncoder(&buf)
+	enc.SetEscapeHTML(false)
+	if err := enc.Encode(r); err != nil {
+		return nil, err
+	}
+	return bytes.TrimSuffix(buf.Bytes(), []byte("\n")), nil
+}
