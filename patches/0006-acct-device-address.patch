+// A record names the device that sent it, after the request's own fields,
+// and writes "<", ">" and "&" as they are: one line of valid JSON, no
+// trailing newline (tacctl patch 0006).
+func TestLocalRecordNamesTheDevice(t *testing.T) {
+	a, _, sink := newLocalTestAccounter(t)
+	req := localMakeRequest(t, localMakeFlag(tq.AcctFlagStart))
+	req.Context = context.WithValue(req.Context, tq.ContextConnRemoteAddr, "192.0.2.10")
+	a.Handle(newMockedResponse(), req)
+	// A connection with no address in its context.
+	a.Handle(newMockedResponse(), localMakeRequest(t, localMakeFlag(tq.AcctFlagStop)))
+
+	assert.Len(t, sink.messages, 2)
+	assert.Regexp(t, `^\{"Flags":\d+,"Method":\d+,"PrivLvl":\d+,"Type":\d+,"Service":\d+,"User":"testuser","Port":"","RemAddr":"","Args":[^{]*,"Device":"192\.0\.2\.10"\}$`, sink.messages[0])
+	assert.Regexp(t, `,"Device":"unknown"\}$`, sink.messages[1])
+	for _, m := range sink.messages {
+		assert.True(t, json.Valid([]byte(m)), m)
+		assert.NotContains(t, m, "\n")
+	}
+}
+
+func TestLocalRecordKeepsAngleBracketsAndAmpersands(t *testing.T) {
+	a, _, sink := newLocalTestAccounter(t)
+	body := tq.NewAcctRequest(
+		tq.SetAcctRequestFlag(localMakeFlag(tq.AcctFlagStop)),
+		tq.SetAcctRequestMethod(tq.AuthenMethodTacacsPlus),
+		tq.SetAcctRequestPrivLvl(tq.PrivLvlRoot),
+		tq.SetAcctRequestType(tq.AuthenTypeASCII),
+		tq.SetAcctRequestService(tq.AuthenServiceLogin),
+		tq.SetAcctRequestUser("alice"),
+		tq.SetAcctRequestArgs(tq.Args{"cmd=set: [interfaces ge-0/0/1 description] <unconfigured> -> \"a&b\"<cr>"}),
+	)
+	b, err := body.MarshalBinary()
+	assert.NoError(t, err)
+	req := localMakeRequest(t, localMakeFlag(tq.AcctFlagStop))
+	req.Body = b
+	req.Context = context.WithValue(req.Context, tq.ContextConnRemoteAddr, "192.0.2.10")
+	a.Handle(newMockedResponse(), req)
+
+	assert.Len(t, sink.messages, 1)
+	assert.Contains(t, sink.messages[0], `"cmd=set: [interfaces ge-0/0/1 description] <unconfigured> -> \"a&b\"<cr>"`)
+	assert.NotContains(t, sink.messages[0], `\u00`)
+	var rec struct {
+		User   string
+		Args   []string
+		Device string
+	}
+	assert.NoError(t, json.Unmarshal([]byte(sink.messages[0]), &rec))
+	assert.Equal(t, "alice", rec.User)
+	assert.Equal(t, "192.0.2.10", rec.Device)
+}
