 	tq "github.com/facebookincubator/tacquito"
 	syslogacct "github.com/facebookincubator/tacquito/cmds/server/config/accounters/syslog"
@@ -144,3 +147,54 @@ func TestSyslogHandleAcctFlags(t *testing.T) {
 		})
