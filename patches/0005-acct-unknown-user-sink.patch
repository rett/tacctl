 }
+
+// internalSession reports whether the record is for 'root' on a port that
+// is not a terminal (tty*, pts*, vty*, con*, aux*, console*, /dev/...):
+// a device's own sessions, which nobody typed (tacctl patch 0005). A root
+// login on the console or over ssh has a terminal and is recorded.
+func internalSession(body tq.AcctRequest) bool {
+	if string(body.User) != "root" {
+		return false
+	}
+	port := strings.ToLower(strings.TrimSpace(string(body.Port)))
+	for _, p := range []string{"tty", "pts", "vty", "con", "aux", "/dev/"} {
+		if strings.HasPrefix(port, p) {
+			return false
+		}
+	}
+	return true
+}
+
+// sinkAccounter is a user of the scope with an accounter: 'root' when it has
+// one, else the first by name; nil when none has (tacctl patch 0005).
+func sinkAccounter(p configProvider) *config.AAA {
+	users, ok := p.(config.AAAProvider)
+	if !ok {
+		return nil
+	}
+	if u := users["root"]; u != nil && u.Accounting != nil {
+		return u
+	}
+	names := make([]string, 0, len(users))
+	for n := range users {
+		names = append(names, n)
+	}
+	sort.Strings(names)
+	for _, n := range names {
+		if u := users[n]; u != nil && u.Accounting != nil {
+			return u
+		}
+	}
+	return nil
+}
