 // evaluate is the main entry point for session based auth flows
 func (sa SessionBasedAuthorizer) evaluate() ([]string, tq.AuthorStatus) {
+	// Some third-party devices (e.g. Peplink Balance) send an exec
+	// authorization whose service is absent or is not one we explicitly
+	// configure. shrubbery tac_plus authorizes these via `default service =
+	// permit`; tacquito is otherwise strict and denies them, which the device
+	// surfaces as "invalid password". Log the raw client args (useful when
+	// onboarding such devices); below we fall back to the user's shell (exec)
+	// values for any non-command exec authorization that matched nothing.
+	sa.Debugf(sa.ctx, "session authz user [%v]: client args %v", sa.user.Name, sa.body.Args.Args())
+	clientNamedCmd := false
+	for _, avp := range sa.body.Args.Args() {
+		if a, _, _ := tq.Arg(avp).ASV(); a == "cmd" {
+			clientNamedCmd = true
+			break
+		}
+	}
 	// overload the body.Args fields to include injected arg concepts in them.  Doing so artifically injects avps into the
 	// requested client args and allows them to behave in evaluation the same as if they came from the client.  We do this for
 	// args that will never present in a client request, but for things we'd like to filter on.  A use cases is filtering for scope
@@ -107,6 +122,22 @@ func (sa SessionBasedAuthorizer) evaluate() ([]string, tq.AuthorStatus) {
 		}
