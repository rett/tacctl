 	}
+
+	// default service = permit: an exec authorization that matched nothing
+	// still gets authorized using the user's shell (exec) service values --
+	// bounded by the user's own group, so this never grants more than the user
+	// already has. Command authorizations are routed to the command authorizer
+	// and are never silently permitted here.
+	if !clientNamedCmd && len(responseArgs.Args()) == 0 {
