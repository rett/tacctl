 	}
+
+	// default service = permit: a client that named no service/command and
+	// matched nothing still gets its exec session authorized using the shell
+	// (exec) service's values, rather than being denied. Clients that DID name
+	// a service we do not authorize remain strictly denied.
+	if !clientNamedService && len(responseArgs.Args()) == 0 {
+		for _, s := range sa.user.Services {
+			if s.Name == "shell" {
+				for _, v := range s.SetValues {
