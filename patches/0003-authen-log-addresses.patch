@@ -139,8 +139,36 @@ func (a Authenticator) Handle(response tq.Response, request tq.Request) {
 		expectedHash = secret
 	}
 
+	// The NAS address, as the server saw the connection (tacctl patch 0003).
+	nasAddr := "unknown"
+	if v := request.Context.Value(tq.ContextConnRemoteAddr); v != nil {
+		nasAddr = fmt.Sprint(v)
+	}
+
+	// The end user's address and port as the client sent them (tacctl patch
+	// 0003): appended after the message so a reader of the NAS address is
+	// unaffected, and omitted when the client sent neither. The client
+	// chooses these bytes, so only printable ASCII without brackets is kept
+	// (at most 64 characters): a value cannot end the field or start a line.
+	clean := func(s string) string {
+		out := make([]rune, 0, len(s))
+		for _, r := range s {
+			if r > ' ' && r < 0x7f && r != '[' && r != ']' && len(out) < 64 {
+				out = append(out, r)
+			}
+		}
+		return string(out)
+	}
+	clientInfo := ""
+	if v, _ := request.Context.Value(tq.ContextClientAddr).(string); clean(v) != "" {
+		clientInfo += fmt.Sprintf("; client [%v]", clean(v))
+	}
+	if v, _ := request.Context.Value(tq.ContextClientPort).(string); clean(v) != "" {
+		clientInfo += fmt.Sprintf(" port [%v]", clean(v))
+	}
+
 	if err := bcrypt.CompareHashAndPassword(expectedHash, []byte(password)); err == nil {
-		a.Infof(request.Context, "accepting user [%v] using a bcrypt password", a.username)
+		a.Infof(request.Context, "accepting user [%v] from [%v] using a bcrypt password%v", a.username, nasAddr, clientInfo)
 		response.Reply(
