# The default listener's accounting log and one per other listener.
/var/log/tacquito/accounting.log /var/log/tacquito/accounting-*.log {
    daily
    rotate 90
    compress
    delaycompress
    missingok
    notifempty
    create 0640 tacquito tacquito
    sharedscripts
    postrotate
        # Restarting tacquito.service restarts every listener's instance too.
        systemctl restart tacquito > /dev/null 2>&1 || true
    endscript
}
