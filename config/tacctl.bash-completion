# bash completion for tacctl (works with and without sudo)

# Capture this file's path and mtime at source time so _tacctl can detect
# when `tacctl upgrade` has replaced it and auto-reload without requiring
# the user to open a new shell.
_TACCTL_COMPLETION_FILE="${BASH_SOURCE[0]}"
_TACCTL_COMPLETION_MTIME=$(stat -c %Y "$_TACCTL_COMPLETION_FILE" 2>/dev/null)

_tacctl() {
    # Auto-reload if the completion file has been updated on disk.
    if [[ -n "$_TACCTL_COMPLETION_FILE" ]]; then
        local _cur_mtime
        _cur_mtime=$(stat -c %Y "$_TACCTL_COMPLETION_FILE" 2>/dev/null)
        if [[ -n "$_cur_mtime" && "$_cur_mtime" != "$_TACCTL_COMPLETION_MTIME" ]]; then
            # shellcheck disable=SC1090
            source "$_TACCTL_COMPLETION_FILE"
            _tacctl "$@"
            return
        fi
    fi

    local cur prev words cword
    _init_completion || return

    # Find where 'tacctl' is in the command line (handles sudo prefix)
    local offset=0
    for ((i = 0; i < ${#words[@]}; i++)); do
        if [[ "${words[i]}" == "tacctl" ]]; then
            offset=$i
            break
        fi
    done

    local pos=$((cword - offset))
    local commands="install upgrade uninstall status passwd user group config scope host backend store log backup hash version"

    # Top-level commands
    if [[ $pos -eq 1 ]]; then
        COMPREPLY=($(compgen -W "$commands" -- "$cur"))
        return
    fi

    local cmd="${words[offset + 1]}"

    # Name lookup for completion. Users, groups, scopes, backup timestamps
    # and backends come from tacctl itself (the store in /etc/tacctl is
    # root-only, and a rendered daemon config such as tacquito.yaml lacks
    # the scopes that backend does not serve), through
    # `sudo -n tacctl _completion-names <kind>` — works as root, or if the
    # operator has installed the NOPASSWD sudoers rule
    # (`tacctl config sudoers install`). No rule → empty completion, which
    # is harmless (operator still types names manually).
    _tacctl_names() {
        # shellcheck disable=SC2086,SC2048  # $* may carry an argument ('listeners <backend>')
        sudo -n tacctl _completion-names $* 2>/dev/null
    }

    _tacctl_scope_names()   { _tacctl_names scopes; }
    _tacctl_user_names()    { _tacctl_names users; }
    _tacctl_group_names()   { _tacctl_names groups; }
    _tacctl_backup_names()  { _tacctl_names backups; }
    _tacctl_backend_names() { _tacctl_names backends; }
    _tacctl_enabled_backend_names() { _tacctl_names enabled-backends; }
    # Listener names, of the backend named by --backend on the line if any.
    _tacctl_listener_names() {
        local w b=""
        for ((w = offset + 1; w < ${#words[@]}; w++)); do
            [[ "${words[w]}" == "--backend" ]] && b="${words[w + 1]}"
        done
        _tacctl_names listeners${b:+ $b}
    }

    case "$cmd" in
        install|upgrade)
            if [[ "$cur" == -* ]]; then
                COMPREPLY=($(compgen -W "--branch" -- "$cur"))
            fi
            ;;
        user)
            local usub="${words[offset + 2]}"
            if [[ $pos -eq 2 ]]; then
                COMPREPLY=($(compgen -W "list show add remove passwd disable enable rename move verify scope" -- "$cur"))
            elif [[ $pos -eq 3 ]]; then
                # <username> completion for every subcommand that targets an
                # existing user. `add` takes a NEW username so no completion;
                # `list` takes no args.
                case "$usub" in
                    show|remove|passwd|disable|enable|rename|move|verify|scope)
                        COMPREPLY=($(compgen -W "$(_tacctl_user_names)" -- "$cur"))
                        ;;
                esac
            elif [[ $pos -eq 4 ]]; then
                case "$usub" in
                    add)
                        # `user add <name> <group>` — offer group names
                        COMPREPLY=($(compgen -W "$(_tacctl_group_names)" -- "$cur"))
                        ;;
                    move)
                        # `user move <user> <newgroup>`
                        COMPREPLY=($(compgen -W "$(_tacctl_group_names)" -- "$cur"))
                        ;;
                    passwd)
                        COMPREPLY=($(compgen -W "--hash" -- "$cur"))
                        ;;
                    scope)
                        # `user scope <user> {list|add|remove|replace}`
                        COMPREPLY=($(compgen -W "list add remove replace" -- "$cur"))
                        ;;
                esac
            elif [[ $pos -eq 5 && "$usub" == "add" ]]; then
                # `user add <name> <group> <flag>`
                COMPREPLY=($(compgen -W "--hash --scopes" -- "$cur"))
            elif [[ $pos -eq 7 && "$usub" == "add" ]]; then
                # second flag after --hash <val> or --scopes <csv>
                COMPREPLY=($(compgen -W "--hash --scopes" -- "$cur"))
            elif [[ $pos -ge 5 && "$usub" == "scope" ]]; then
                # `user scope <user> {add|remove|replace} <scope>[,<scope>...]`
                # and `user scope <user> remove --all` (--all only in the
                # first slot, and takes no scope names after it).
                # Slot layout: [offset+2]=scope [offset+3]=<user> [offset+4]=<sub>
                case "${words[offset + 4]}" in
                    add|replace)
                        COMPREPLY=($(compgen -W "$(_tacctl_scope_names)" -- "$cur"))
                        ;;
                    remove)
                        if [[ $pos -eq 5 ]]; then
                            COMPREPLY=($(compgen -W "--all $(_tacctl_scope_names)" -- "$cur"))
                        elif [[ "${words[offset + 5]}" != "--all" ]]; then
                            COMPREPLY=($(compgen -W "$(_tacctl_scope_names)" -- "$cur"))
                        fi
                        ;;
                esac
            fi
            ;;
        group)
            local gsub="${words[offset + 2]}"
            if [[ $pos -eq 2 ]]; then
                COMPREPLY=($(compgen -W "list add edit remove commands privilege" -- "$cur"))
            elif [[ $pos -eq 3 ]]; then
                case "$gsub" in
                    edit|remove)
                        COMPREPLY=($(compgen -W "$(_tacctl_group_names)" -- "$cur"))
                        ;;
                    commands)
                        COMPREPLY=($(compgen -W "list default add remove clear seed" -- "$cur"))
                        ;;
                    privilege)
                        COMPREPLY=($(compgen -W "list add remove clear seed" -- "$cur"))
                        ;;
                esac
            elif [[ $pos -eq 4 ]]; then
                case "$gsub" in
                    edit)
                        # `group edit <group> <priv-lvl|juniper-class>`
                        COMPREPLY=($(compgen -W "priv-lvl juniper-class" -- "$cur"))
                        ;;
                    commands|privilege)
                        # `group commands <sub> <group>` / `group privilege <sub> <group>`
                        COMPREPLY=($(compgen -W "$(_tacctl_group_names)" -- "$cur"))
                        ;;
                esac
            elif [[ $pos -eq 5 && "$gsub" == "commands" ]]; then
                # `group commands default <group> <permit|deny>`
                # Slot layout: [offset+2]=commands [offset+3]=<sub> [offset+4]=<group>
                if [[ "${words[offset + 3]}" == "default" ]]; then
                    COMPREPLY=($(compgen -W "permit deny" -- "$cur"))
                fi
            elif [[ $pos -ge 6 && "$gsub" == "commands" && "${words[offset + 3]}" == "add" ]]; then
                # `group commands add <group> <name> [--match <regex>]... [--action permit|deny]`
                case "${words[cword - 1]}" in
                    --action) COMPREPLY=($(compgen -W "permit deny" -- "$cur")) ;;
                    --match)  COMPREPLY=() ;;  # free-form regex
                    *)        COMPREPLY=($(compgen -W "--match --action" -- "$cur")) ;;
                esac
            fi
            ;;
        config)
            if [[ $pos -eq 2 ]]; then
                COMPREPLY=($(compgen -W "show dump defaults get get-list cisco juniper wti linux validate render loglevel listen metrics sudoers password-age bcrypt-cost password-min-length secret-min-length diff restore allow deny mgmt-acl branch" -- "$cur"))
            elif [[ $pos -eq 3 ]]; then
                case "${words[offset + 2]}" in
                    loglevel)
                        COMPREPLY=($(compgen -W "debug info error" -- "$cur"))
                        ;;
                    listen)
                        COMPREPLY=($(compgen -W "show tcp tcp6 reset --backend --listener" -- "$cur"))
                        ;;
                    render)
                        COMPREPLY=($(compgen -W "--force" -- "$cur"))
                        ;;
                    metrics)
                        COMPREPLY=($(compgen -W "show enable disable address reset" -- "$cur"))
                        ;;
                    linux)
                        COMPREPLY=($(compgen -W "build script remove-script uid builds" -- "$cur"))
                        ;;
                    sudoers)
                        COMPREPLY=($(compgen -W "show install remove tiers" -- "$cur"))
                        ;;
                    allow|deny)
                        COMPREPLY=($(compgen -W "list add remove clear" -- "$cur"))
                        ;;
                    mgmt-acl)
                        COMPREPLY=($(compgen -W "list add remove clear cisco-name juniper-name" -- "$cur"))
                        ;;
                    cisco)
                        COMPREPLY=($(compgen -W "--scope --legacy --protocol" -- "$cur"))
                        ;;
                    juniper)
                        COMPREPLY=($(compgen -W "--scope --protocol" -- "$cur"))
                        ;;
                    wti)
                        COMPREPLY=($(compgen -W "--scope --protocol" -- "$cur"))
                        ;;
                    get|get-list)
                        # Dotted paths into the merged config. Offering the
                        # shipped top-level keys covers the common case;
                        # operators can still tab through nested paths by
                        # typing the dot manually.
                        COMPREPLY=($(compgen -W "bcrypt.cost password.max_age_days password.min_length secret.min_length scope.default mgmt_acl.names.cisco mgmt_acl.names.juniper mgmt_acl.permits privileges.operator commands.superuser commands.operator commands.readonly" -- "$cur"))
                        ;;
                    diff|restore)
                        # `config diff|restore [timestamp]` — backup timestamps.
                        COMPREPLY=($(compgen -W "$(_tacctl_backup_names)" -- "$cur"))
                        ;;
                esac
            elif [[ $pos -ge 4 && "${words[offset + 2]}" == "listen" ]]; then
                # `config listen [--backend <id>] [--listener <name>] <show|tcp|tcp6|reset> [addr]`
                case "${words[cword - 1]}" in
                    --backend)  COMPREPLY=($(compgen -W "$(_tacctl_backend_names)" -- "$cur")) ;;
                    --listener) COMPREPLY=($(compgen -W "$(_tacctl_listener_names)" -- "$cur")) ;;
                    *)
                        local lflags="show tcp tcp6 reset"
                        [[ " ${words[*]} " == *" --backend radius "* ]] && lflags="show udp udp6 reset"
                        [[ " ${words[*]} " == *" --backend "* ]]  || lflags+=" --backend"
                        [[ " ${words[*]} " == *" --listener "* ]] || lflags+=" --listener"
                        COMPREPLY=($(compgen -W "$lflags" -- "$cur"))
                        ;;
                esac
            elif [[ $pos -ge 4 && "${words[offset + 2]}" == "linux" ]]; then
                # `config linux script [--scope <s>] [--server <a>] [--method <m>] [--output <f>]`,
                # `config linux builds [list|clear]`, `config linux uid [<user> [<uid>]]`
                case "${words[offset + 3]}" in
                    script)
                        case "${words[cword - 1]}" in
                            --scope)  COMPREPLY=($(compgen -W "$(_tacctl_scope_names)" -- "$cur")) ;;
                            --method) COMPREPLY=($(compgen -W "tacplus radius" -- "$cur")) ;;
                            --output|-o) COMPREPLY=($(compgen -f -- "$cur")) ;;
                            --server) COMPREPLY=() ;;
                            *) COMPREPLY=($(compgen -W "--scope --server --method --output" -- "$cur")) ;;
                        esac
                        ;;
                    remove-script)
                        if [[ "${words[cword - 1]}" == "--output" || "${words[cword - 1]}" == "-o" ]]; then
                            COMPREPLY=($(compgen -f -- "$cur"))
                        else
                            COMPREPLY=($(compgen -W "--output" -- "$cur"))
                        fi
                        ;;
                    builds)
                        [[ $pos -eq 4 ]] && COMPREPLY=($(compgen -W "list clear" -- "$cur"))
                        ;;
                    uid)
                        [[ $pos -eq 4 ]] && COMPREPLY=($(compgen -W "$(_tacctl_user_names)" -- "$cur"))
                        ;;
                esac
            elif [[ $pos -eq 4 && ( "${words[offset + 2]}" == "diff" || "${words[offset + 2]}" == "restore" ) ]]; then
                [[ "${words[offset + 2]}" == "restore" ]] && COMPREPLY=($(compgen -W "--legacy" -- "$cur"))
            elif [[ $pos -ge 4 && ( "${words[offset + 2]}" == "cisco" || "${words[offset + 2]}" == "juniper" || "${words[offset + 2]}" == "wti" ) ]]; then
                if [[ "${words[cword - 1]}" == "--scope" ]]; then
                    COMPREPLY=($(compgen -W "$(_tacctl_scope_names)" -- "$cur"))
                elif [[ "${words[cword - 1]}" == "--protocol" ]]; then
                    COMPREPLY=($(compgen -W "tacacs radius" -- "$cur"))
                else
                    # Offer whichever flag isn't already on the line.
                    local cflags=""
                    [[ " ${words[*]} " == *" --scope "* ]]    || cflags+=" --scope"
                    [[ " ${words[*]} " == *" --protocol "* ]] || cflags+=" --protocol"
                    [[ "${words[offset + 2]}" == "cisco" && " ${words[*]} " != *" --legacy "* ]] && cflags+=" --legacy"
                    COMPREPLY=($(compgen -W "$cflags" -- "$cur"))
                fi
            fi
            ;;
        host)
            if [[ $pos -eq 2 ]]; then
                COMPREPLY=($(compgen -W "list enroll sync unenroll default-method" -- "$cur"))
            elif [[ "$prev" == "--method" || ( $pos -eq 3 && "${words[offset + 2]}" == "default-method" ) ]]; then
                COMPREPLY=($(compgen -W "tacplus radius" -- "$cur"))
            elif [[ "$prev" == "--scope" ]]; then
                COMPREPLY=($(compgen -W "$(_tacctl_scope_names)" -- "$cur"))
            elif [[ "$cur" == -* ]]; then
                COMPREPLY=($(compgen -W "--local --scope --server --name --port --identity --method --all --force --allow-uid-mismatch --adopt --build-on-host" -- "$cur"))
            fi
            ;;
        scope)
            local ssub="${words[offset + 2]}"
            if [[ $pos -eq 2 ]]; then
                COMPREPLY=($(compgen -W "list routing show add remove rename default lookup prefixes secret protocols vendor-attrs devices aaa-order exec-timeout tacacs-group radius-group auth-method mgmt-acl" -- "$cur"))
            elif [[ $pos -eq 3 ]]; then
                case "$ssub" in
                    show|remove|rename|default|prefixes|secret|protocols|vendor-attrs|devices|aaa-order|exec-timeout|tacacs-group|radius-group|auth-method|mgmt-acl)
                        COMPREPLY=($(compgen -W "$(_tacctl_scope_names)" -- "$cur"))
                        ;;
                    lookup)
                        # free-form IP or CIDR — no completion
                        COMPREPLY=()
                        ;;
                esac
            elif [[ $pos -eq 4 ]]; then
                case "$ssub" in
                    add)
                        # `scope add <name> <flag>`
                        COMPREPLY=($(compgen -W "--prefixes --secret --protocols --vendor-attrs --default" -- "$cur"))
                        ;;
                    prefixes)
                        # `scope prefixes <scope> <list|add|remove>`
                        COMPREPLY=($(compgen -W "list add remove" -- "$cur"))
                        ;;
                    secret)
                        # `scope secret <scope> <show|set|generate>`
                        COMPREPLY=($(compgen -W "show set generate" -- "$cur"))
                        ;;
                    protocols)
                        # `scope protocols <scope> <list|set|clear>`
                        COMPREPLY=($(compgen -W "list set clear" -- "$cur"))
                        ;;
                    vendor-attrs)
                        # `scope vendor-attrs <scope> <enable|disable>` (no set/clear: opt-in)
                        COMPREPLY=($(compgen -W "enable disable" -- "$cur"))
                        ;;
                    devices)
                        # `scope devices <scope> <list|set|unset>`
                        COMPREPLY=($(compgen -W "list set unset" -- "$cur"))
                        ;;
                    aaa-order)
                        # `scope aaa-order <scope> <tacacs-first|local-first>`
                        COMPREPLY=($(compgen -W "tacacs-first local-first" -- "$cur"))
                        ;;
                    auth-method)
                        # `scope auth-method <scope> <tacacs|radius|clear>`
                        COMPREPLY=($(compgen -W "tacacs radius clear" -- "$cur"))
                        ;;
                    mgmt-acl)
                        # `scope mgmt-acl <scope> <sub>` — name setters + permit-list ops.
                        COMPREPLY=($(compgen -W "list add remove clear cisco-name juniper-name" -- "$cur"))
                        ;;
                    rename)
                        # `scope rename <old> <new>` — no completion on new name
                        COMPREPLY=()
                        ;;
                    remove)
                        # `scope remove <name> [--force]`
                        COMPREPLY=($(compgen -W "--force" -- "$cur"))
                        ;;
                esac
            elif [[ $pos -eq 5 && "$ssub" == "vendor-attrs" ]]; then
                # `scope vendor-attrs <scope> enable|disable <vendor>[,<vendor>...]`
                case "${words[offset + 4]}" in
                    enable|disable) COMPREPLY=($(compgen -W "cisco juniper wti cisco,juniper cisco,juniper,wti" -- "$cur")) ;;
                esac
            elif [[ $pos -eq 6 && "$ssub" == "devices" && "${words[offset + 4]}" == "set" ]]; then
                # `scope devices <scope> set <ip|cidr> <vendor>`
                COMPREPLY=($(compgen -W "cisco juniper wti" -- "$cur"))
            elif [[ $pos -eq 5 && "$ssub" == "protocols" ]]; then
                # `scope protocols <scope> set <protocol>[,<protocol>...]`
                if [[ "${words[offset + 4]}" == "set" ]]; then
                    COMPREPLY=($(compgen -W "tacacs radius tacacs,radius" -- "$cur"))
                fi
            elif [[ $pos -ge 5 && "$ssub" == "prefixes" ]]; then
                # `scope prefixes <scope> remove --all [--force]` — only
                # 'remove --all' takes --force; CIDRs are free-form.
                # Slot layout: [offset+2]=prefixes [offset+3]=<scope> [offset+4]=<sub>
                if [[ "${words[offset + 4]}" == "remove" ]]; then
                    if [[ $pos -eq 5 ]]; then
                        COMPREPLY=($(compgen -W "--all" -- "$cur"))
                    elif [[ $pos -eq 6 && "${words[offset + 5]}" == "--all" ]]; then
                        COMPREPLY=($(compgen -W "--force" -- "$cur"))
                    fi
                fi
            elif [[ $pos -ge 6 && "$ssub" == "add" ]]; then
                # `scope add <name> --flag <val> [--flag ...]` — offer remaining
                # flags not already seen. Covers the second/third flag slots.
                local seen_flags=""
                local w
                for ((w = offset + 3; w < cword; w++)); do
                    case "${words[w]}" in
                        --prefixes|--secret|--protocols|--vendor-attrs|--default) seen_flags+=" ${words[w]}" ;;
                    esac
                done
                local choices=""
                [[ "$seen_flags" != *--prefixes* ]] && choices+=" --prefixes"
                [[ "$seen_flags" != *--secret*   ]] && choices+=" --secret"
                [[ "$seen_flags" != *--protocols* ]] && choices+=" --protocols"
                [[ "$seen_flags" != *--vendor-attrs* ]] && choices+=" --vendor-attrs"
                [[ "$seen_flags" != *--default*  ]] && choices+=" --default"
                # Flag position: only offer when the cursor is on a new token
                # (i.e. the previous token is a value, not one of our flags
                # that still needs a value).
                case "${words[cword - 1]}" in
                    --vendor-attrs) COMPREPLY=($(compgen -W "cisco juniper wti cisco,juniper cisco,juniper,wti" -- "$cur")) ;;
                    --protocols) COMPREPLY=($(compgen -W "tacacs radius tacacs,radius" -- "$cur")) ;;
                    --prefixes|--secret) COMPREPLY=() ;;  # value expected
                    *) COMPREPLY=($(compgen -W "$choices" -- "$cur")) ;;
                esac
            fi
            ;;
        log)
            if [[ $pos -eq 2 ]]; then
                COMPREPLY=($(compgen -W "tail search failures accounting clear" -- "$cur"))
            elif [[ "${words[cword - 1]}" == "--backend" ]]; then
                COMPREPLY=($(compgen -W "$(_tacctl_backend_names)" -- "$cur"))
            elif [[ "$cur" == -* || ( -z "$cur" && "${words[offset + 2]}" == "clear" ) ]]; then
                local lgflags="--backend"
                [[ "${words[offset + 2]}" == "clear" ]] && lgflags+=" --force"
                [[ " ${words[*]} " == *" --backend "* ]] && lgflags="${lgflags/--backend/}"
                [[ " ${words[*]} " == *" --force "* ]] && lgflags="${lgflags/--force/}"
                COMPREPLY=($(compgen -W "$lgflags" -- "$cur"))
            fi
            ;;
        backend)
            local bsub="${words[offset + 2]}"
            if [[ $pos -eq 2 ]]; then
                COMPREPLY=($(compgen -W "list status enable disable" -- "$cur"))
            elif [[ $pos -eq 3 ]]; then
                case "$bsub" in
                    status|enable)
                        COMPREPLY=($(compgen -W "$(_tacctl_backend_names)" -- "$cur"))
                        ;;
                    disable)
                        COMPREPLY=($(compgen -W "$(_tacctl_enabled_backend_names)" -- "$cur"))
                        ;;
                esac
            elif [[ $pos -eq 4 ]]; then
                case "$bsub" in
                    enable|disable)
                        COMPREPLY=($(compgen -W "-y --yes" -- "$cur"))
                        ;;
                esac
            fi
            ;;
        store)
            local tsub="${words[offset + 2]}"
            if [[ $pos -eq 2 ]]; then
                COMPREPLY=($(compgen -W "show import rollback" -- "$cur"))
            else
                case "$tsub" in
                    show)   COMPREPLY=($(compgen -W "--json" -- "$cur")) ;;
                    import)
                        if [[ "$cur" == -* ]]; then
                            COMPREPLY=($(compgen -W "--check --force --replace" -- "$cur"))
                        else
                            # <file>: an old-style tacquito.yaml
                            COMPREPLY=($(compgen -f -- "$cur"))
                        fi
                        ;;
                esac
            fi
            ;;
        backup)
            if [[ $pos -eq 2 ]]; then
                COMPREPLY=($(compgen -W "list diff restore" -- "$cur"))
            elif [[ $pos -eq 3 ]]; then
                case "${words[offset + 2]}" in
                    diff|restore)
                        COMPREPLY=($(compgen -W "$(_tacctl_backup_names)" -- "$cur"))
                        ;;
                esac
            elif [[ $pos -eq 4 && "${words[offset + 2]}" == "restore" ]]; then
                COMPREPLY=($(compgen -W "--legacy" -- "$cur"))
            fi
            ;;
        hash)
            if [[ $pos -eq 2 ]]; then
                COMPREPLY=($(compgen -W "generate commands help" -- "$cur"))
            fi
            ;;
    esac
}

complete -F _tacctl tacctl
complete -F _tacctl sudo
