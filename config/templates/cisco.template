${HARDENING_BLOCK}
!
${BREAKGLASS_BLOCK}
!
! --- Step 1: TACACS+ server, group and AAA (the standard block) ---
! The order keeps the session you paste from alive: 'aaa new-model' first (nothing under 'aaa'
! exists on IOS until it is set), then the server and its group, the login lists and exec
! authorization. Command authorization is not in this step: it is Step 2, after a
! check from a new session (below), because a server that answers 'fail' (for a name it does not
! know, such as the local user you paste from) is final and never falls through to 'local'. From
! 'aaa new-model' until the login lists are typed a NEW TACACS+ login would fail (a local user
! still gets in): paste the block in one go and keep the session you paste from.
! Encrypt Type 0 plaintext secrets in running-config.
! (Type 7 is trivially reversible; for Type 6 AES encryption of the
!  TACACS+ key, run 'key config-key password-encrypt <master>' first,
!  then re-enter the key with 'key 6 <encrypted-string>'.)
service password-encryption
!
aaa new-model
!
tacacs server TACACS
  address ipv4 ${SERVER_IP}
${TACACS_PORT_LINE}
  key ${SECRET}
  single-connection
  timeout 5
!
aaa group server tacacs+ ${TACACS_GROUP}
  server name TACACS
!
${SOURCE_INTERFACE_BLOCK}
!
! 'default' is the vty lines' login list; CONSOLE is the console's, local only: with the
! server up a local user logs in on the console, and lands at privilege 1 (see Notes below).
aaa authentication login default ${AUTHN_METHODS}
aaa authentication login CONSOLE local
aaa authorization exec default ${AUTHZ_EXEC_METHODS}
! There is no enable list: 'enable' uses the local enable secret and nothing else (with an 'enable'
! list that asks the server, anyone the server knows reaches level 15 with their own password).
aaa accounting exec default start-stop group ${TACACS_GROUP}
${ACCT_COMMANDS_BLOCK}
aaa session-id common
!
${PRIVILEGE_COMMANDS}
${SNMP_BLOCK}
!
${VTY_ACL_BLOCK}
!
${NETCONF_BLOCK}
!
line con 0
  login authentication CONSOLE
  exec-timeout ${EXEC_TIMEOUT} 0
!
line vty 0 15
  login authentication default
  transport input ssh
${VTY_ACCESS_CLASS}
  exec-timeout ${EXEC_TIMEOUT} 0
!
${AUTHZ_COMMANDS_BLOCK}
