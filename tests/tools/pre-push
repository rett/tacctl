#!/usr/bin/env bash
# git pre-push hook (install with 'make hooks'): refuse a push whose tree or
# new commit messages name private infrastructure (tests/tools/no-private.sh).
set -euo pipefail

top=$(git rev-parse --show-toplevel)
zero=0000000000000000000000000000000000000000
status=0
while read -r _local_ref local_sha _remote_ref remote_sha; do
    [[ "$local_sha" == "$zero" ]] && continue   # a deletion pushes no content
    # A new branch, or a force push over commits this clone does not have.
    if [[ "$remote_sha" == "$zero" ]] || ! git cat-file -e "$remote_sha^{commit}" 2>/dev/null; then
        range=("$local_sha" --not --remotes)
    else
        range=("$remote_sha..$local_sha")
    fi
    "$top/tests/tools/no-private.sh" --rev "$local_sha" --messages "${range[@]}" || status=1
done
exit "$status"
