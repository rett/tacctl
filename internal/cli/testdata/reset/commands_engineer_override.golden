    - test         deny   ^(aaa)( .*)?$
    - debug        deny   ^(all|aaa|tacacs|radius)( .*)?$
    - clear        deny   ^(aaa|logging|archive)( .*)?$
    - do           deny   ^(reload|copy|delete|erase|format|fsck|rename|mkdir|rmdir|write erase|request|install|software|upgrade|issu|archive|configure|clear (aaa|logging|archive)|debug (all|aaa|tacacs|radius)|test aaa|tclsh|guestshell|app-hosting|iox|scripting|hw-module|redundancy|switch)( .*)?$
    - extra        deny   ^(x)$
